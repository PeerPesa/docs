{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "PeerPesa",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "kyc-verification",
              "authentication",
              "supported-currencies"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "webhooks",
              "errors",
              "pagination"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              {
                "group": "Network",
                "icon": "globe",
                "expanded": true,
                "pages": [
                  "api-reference/network-stats",
                  "api-reference/coins",
                  "api-reference/rates",
                  "api-reference/fees"
                ]
              },
              {
                "group": "Ramps",
                "icon": "arrow-right-arrow-left",
                "expanded": false,
                "pages": [
                  "api-reference/quotes",
                  "api-reference/onramp",
                  "api-reference/offramp"
                ]
              },
              {
                "group": "Wallet Operations",
                "icon": "wallet",
                "expanded": false,
                "pages": [
                  "api-reference/balances",
                  "api-reference/deposit-wallets",
                  "api-reference/withdraw",
                  "api-reference/send",
                  "api-reference/buy",
                  "api-reference/swap",
                  "api-reference/recurring-payments"
                ]
              },
              {
                "group": "Account & Records",
                "icon": "user",
                "expanded": false,
                "pages": [
                  "api-reference/profile",
                  "api-reference/orders",
                  "api-reference/order-details",
                  "api-reference/beneficiaries"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/peerpesa-logo.png",
    "dark": "/logo/peerpesa-logo.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://peerpesa.co/faqs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "PeerPesa",
      "href": "https://peerpesa.co"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/PeerPesa"
    }
  }
}
